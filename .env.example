# Copy to .env for local VS Code runs.  .env is gitignored — never commit it.
# (For the systemd deployment, secrets live in /etc/forge-agent/env instead.)
ANTHROPIC_API_KEY=sk-ant-...

# Optional dead-man's switch. Leave unset for local dev — you don't want
# laptop test runs pinging the same check your production timer uses.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
