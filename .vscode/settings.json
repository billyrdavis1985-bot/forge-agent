{
  // Project venv. VS Code resolves the right one per-OS if you select the
  // interpreter via the command palette; this is the Linux/macOS default.
  // On Windows select ".venv\\Scripts\\python.exe" instead.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.activateEnvironment": true,

  // The agent rewrites memory/ while you may have it open. Auto-reload the
  // editor from disk instead of prompting on every run.
  "files.autoSave": "onFocusChange",

  // Transcripts and the ledger are generated artifacts — keep them out of
  // search results and the file tree so they don't drown the source.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.run.lock": true
  },
  "search.exclude": {
    "runs/**": true,
    "memory/state.db": true,
    ".venv/**": true
  },

  // Don't let the formatter reflow the memory protocol docs — the agent reads
  // them literally and wrapping changes can alter how instructions parse.
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.wordWrap": "on"
  },

  "[python]": {
    "editor.rulers": [88]
  },

  // config/agent.yaml is load-bearing; surface schema errors early.
  "[yaml]": {
    "editor.formatOnSave": false
  }
}
